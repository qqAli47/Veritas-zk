{
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "plugins": ["prettier-plugin-solidity"],
  "overrides": [
    { "files": "*.sol", "options": { "printWidth": 100, "tabWidth": 4, "singleQuote": false } },
    { "files": "*.circom", "options": { "parser": "babel" } }
  ]
}
