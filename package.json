{
  "name": "veritas-zk",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-preserving attribute verification using zk-SNARKs",
  "scripts": {
    "zk:build": "node scripts/zk/build.mjs",
    "zk:rebuild": "node scripts/zk/build.mjs --force",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "cross-env REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "demo:local": "hardhat run scripts/demo.js --network localhost",
    "demo:sepolia": "hardhat run scripts/demo.js --network sepolia",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,json,md,sol}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md,sol}\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "ethers": "^6.0.0",
    "hardhat": "^2.16.0",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.1",
    "snarkjs": "^0.7.0",
    "solidity-coverage": "^0.8.17"
  },
  "dependencies": {
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "poseidon-lite": "^0.3.0"
  }
}
