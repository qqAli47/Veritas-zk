# ═══════════════════════════════════════════════════════════════════
#  Veritas-zk — frontend environment template
#  `npm run deploy:local` / `deploy:sepolia` writes a ready-made
#  `.env.local` for you; this file documents the variables.
# ═══════════════════════════════════════════════════════════════════

# Deployed contract addresses
VITE_CORE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# Target network. 11155111 = Sepolia, 31337 = local Hardhat node.
VITE_CHAIN_ID=11155111
VITE_NETWORK_NAME=sepolia

# Block explorer base URL used for transaction links (blank for local).
VITE_EXPLORER_URL=https://sepolia.etherscan.io
